{
    "openapi": "3.1.2",
    "info": {
        "title": "Lockmate API",
        "version": "1",
        "description": "Lockmate API, version 1. Responses honour Accept-Language (en, ar)."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/targets": {
            "post": {
                "operationId": "v1.targets.calculate",
                "description": "Daily calories and macros for a person and a goal, with the safety gates applied. Public and\nrate-limited, for the website calculators and app onboarding. Nothing is saved.",
                "summary": "Calculate daily targets",
                "tags": [
                    "CalculateTargets"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CalculateTargetsRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`TargetsResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/TargetsResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/me": {
            "get": {
                "operationId": "v1.me",
                "summary": "The signed-in user",
                "tags": [
                    "CurrentUser"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "operationId": "v1.auth.login",
                "description": "Returns a new token for this device. A wrong email and a wrong password get the same answer.",
                "summary": "Sign in",
                "tags": [
                    "Login"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`IssuedTokenResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/IssuedTokenResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "v1.auth.logout",
                "description": "Revokes the token the request was made with. Other devices stay signed in.",
                "summary": "Sign out this device",
                "tags": [
                    "Logout"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "operationId": "v1.auth.register",
                "description": "Returns a token for this device: keep it in secure storage and send it as a bearer token.",
                "summary": "Create an account",
                "tags": [
                    "Register"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`IssuedTokenResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/IssuedTokenResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/status": {
            "get": {
                "operationId": "v1.status",
                "description": "Liveness, plus the language the API negotiated from Accept-Language.",
                "summary": "API status",
                "tags": [
                    "Status"
                ],
                "responses": {
                    "200": {
                        "description": "`StatusResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/StatusResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "ActivityLevel": {
                "type": "string",
                "enum": [
                    "sedentary",
                    "light",
                    "moderate",
                    "active",
                    "very_active"
                ],
                "title": "ActivityLevel"
            },
            "CalculateTargetsRequest": {
                "type": "object",
                "properties": {
                    "sex": {
                        "$ref": "#/components/schemas/Sex"
                    },
                    "age": {
                        "type": "integer",
                        "minimum": 13,
                        "maximum": 100
                    },
                    "height_cm": {
                        "type": "number",
                        "minimum": 100,
                        "maximum": 250
                    },
                    "weight_kg": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                    },
                    "activity": {
                        "$ref": "#/components/schemas/ActivityLevel"
                    },
                    "goal": {
                        "$ref": "#/components/schemas/Goal"
                    },
                    "weekly_pace_kg": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2
                    },
                    "body_fat_percent": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "minimum": 3,
                        "maximum": 70
                    },
                    "conditions": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/HealthCondition"
                        },
                        "uniqueItems": true
                    }
                },
                "required": [
                    "sex",
                    "age",
                    "height_cm",
                    "weight_kg",
                    "activity",
                    "goal"
                ],
                "title": "CalculateTargetsRequest"
            },
            "Goal": {
                "type": "string",
                "enum": [
                    "lose_fat",
                    "maintain",
                    "gain_muscle"
                ],
                "title": "Goal"
            },
            "HealthCondition": {
                "type": "string",
                "description": "Anything a person reports that rules out a deficit and sends them to a professional (PLAN \u00a74.3).\n",
                "enum": [
                    "pregnant",
                    "breastfeeding",
                    "diabetes",
                    "kidney_disease",
                    "eating_disorder_history"
                ],
                "title": "HealthCondition"
            },
            "IssuedTokenResource": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "token_type": {
                        "type": "string",
                        "const": "Bearer"
                    },
                    "user": {
                        "$ref": "#/components/schemas/UserResource"
                    }
                },
                "required": [
                    "token",
                    "token_type",
                    "user"
                ],
                "title": "IssuedTokenResource"
            },
            "Locale": {
                "type": "string",
                "enum": [
                    "en",
                    "ar"
                ],
                "title": "Locale"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string"
                    },
                    "device_name": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email",
                    "password",
                    "device_name"
                ],
                "title": "LoginRequest"
            },
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string"
                    },
                    "device_name": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "name",
                    "email",
                    "password",
                    "device_name"
                ],
                "title": "RegisterRequest"
            },
            "SafetyNote": {
                "type": "string",
                "description": "Why the targets differ from what was asked for. The apps explain each one to the person.\n| |\n|---|\n| `see_a_professional` <br/> Under 18 or a reported condition: maintenance only, and a professional's advice. |\n| `pace_capped` <br/> The requested pace was faster than the safe weekly rate. |\n| `raised_to_calorie_floor` <br/> The target fell below the daily calorie floor and was raised to it. |",
                "enum": [
                    "see_a_professional",
                    "pace_capped",
                    "raised_to_calorie_floor"
                ],
                "title": "SafetyNote"
            },
            "Sex": {
                "type": "string",
                "enum": [
                    "female",
                    "male"
                ],
                "title": "Sex"
            },
            "StatusResource": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "const": "ok"
                    },
                    "locale": {
                        "$ref": "#/components/schemas/Locale"
                    }
                },
                "required": [
                    "status",
                    "locale"
                ],
                "title": "StatusResource"
            },
            "TargetsResource": {
                "type": "object",
                "properties": {
                    "kcal": {
                        "type": "integer"
                    },
                    "protein_g": {
                        "type": "integer"
                    },
                    "carbs_g": {
                        "type": "integer"
                    },
                    "fat_g": {
                        "type": "integer"
                    },
                    "bmr_kcal": {
                        "type": "integer"
                    },
                    "maintenance_kcal": {
                        "type": "integer"
                    },
                    "notes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SafetyNote"
                        }
                    },
                    "formula_version": {
                        "type": "string"
                    }
                },
                "required": [
                    "kcal",
                    "protein_g",
                    "carbs_g",
                    "fat_g",
                    "bmr_kcal",
                    "maintenance_kcal",
                    "notes",
                    "formula_version"
                ],
                "title": "TargetsResource"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email"
                ],
                "title": "UserResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}