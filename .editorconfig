root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[docker-compose.yml]
indent_size = 4

# JavaScript side: 2 spaces, as Prettier formats it (packages/config).
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

[packages/**.json]
indent_size = 2
